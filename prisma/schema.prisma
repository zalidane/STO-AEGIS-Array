generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Ship {
  id Int @id @default(autoincrement())

  name               String  @unique
  description        String?
  tier               Int?
  type               String?
  hull               String?
  hullMod            Float?
  shieldMod          Float?
  turnRate           Float?
  impulse            Float?
  inertia            Int?
  foreWeapons        Int?
  aftWeapons         Int?
  tacticalSlots      Int?
  engineeringSlots   Int?
  scienceSlots       Int?
  secondaryDeflector Boolean @default(false)

  rawData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StarshipTrait {
  id Int @id @default(autoincrement())

  name     String  @unique
  short    String?
  basic    String?
  detailed String?
  type     String?
  obtained String?
  iconName String?
  tag      String?
  tag2     String?
  tag3     String?

  rawData Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Trait {
  Id Int @id @default(autoincrement())

  name             String
  type             String?
  environment      String?

  description      String?
  shortDescription String?
  required         String?
  possible         String?
  career           String?
  source           String?
  charVariant      String?
  boffVariant      String?
  doffVariant      String?
  iconName         String?
  master           String?

  rawData Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, type, environment])
}

model GwObtain {
  id     Int     @id @default(autoincrement())
  cat    String
  type   String
  flavor String
  box    String?
  lb     String?
  rep    String?
  rawData Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([cat, type, flavor])
}

model SwObtain {
  id     Int     @id @default(autoincrement())
  cat    String
  type   String
  flavor String
  box    String?
  lb     String?
  rep    String?
  ships  String?
  rawData Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([cat, type, flavor])
}

model Modifier {
  id        Int     @id @default(autoincrement())
  modifier  String
  stats     String?
  type      String
  available String?   // comma-separated list — keep as String
  isunique  Boolean   @default(false)
  isepic    Boolean   @default(false)
  info      String?
  rawData   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([modifier, type])
}

model Reputation {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  color1      String?
  color2      String?
  icon        String?
  link        String?
  description String?
  released    String?
  environment String?  
  boff        Boolean?
  secondary   Boolean?
  rawData     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SetBonus {
  id         Int     @id @default(autoincrement())
  name       String  @unique          // cargo: Name
  setPage    String?                  // SetPage
  reqItems   Int?                     // ReqItems as Int
  passives   String?                  // ;-separated — keep String
  traySkills String?
  procs      String?
  abilities  String?
  rawData    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TraySkill {
  id              Int     @id @default(autoincrement())
  name            String  @unique
  system          String?
  description     String?
  descriptionLong String?   // cargo: "description long"
  targets         String?
  affects         String?
  activation      String?   // keep String (mix of "0.5" and "1.25 seconds")
  rechargeBase    Int?      // "recharge base"
  rechargeGlobal  Int?      // "recharge global"
  type            String?
  region          String?
  rank1rank       String?
  rank2rank       String?
  rank3rank       String?
  rank4rank       String?
  rank5rank       String?
  rank1info       String?
  rank2info       String?
  rank3info       String?
  rank4info       String?
  rank5info       String?
  rawData         Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Infobox {
  id         Int     @id @default(autoincrement())
  name       String
  rarity     String?
  type       String?
  boundto    String?
  boundwhen  String?
  who        String?
  head1      String?
  head2      String?
  head3      String?
  head4      String?
  head5      String?
  head6      String?
  head7      String?
  head8      String?
  head9      String?
  subhead1   String?
  subhead2   String?
  subhead3   String?
  subhead4   String?
  subhead5   String?
  subhead6   String?
  subhead7   String?
  subhead8   String?
  subhead9   String?
  text1      String?
  text2      String?
  text3      String?
  text4      String?
  text5      String?
  text6      String?
  text7      String?
  text8      String?
  text9      String?
  equiplimit Int?
  rawData    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([name])
}

model Mastery {
  id              Int     @id @default(autoincrement())
  masterytype     String
  shiptype        String
  shipfaction     String
  masterypackage  String
  trait           String?
  traitdesc       String?
  trait2          String?
  traitdesc2      String?
  trait3          String?
  traitdesc3      String?
  acctrait        String?
  acctraitdesc    String?
  rawData         Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([masterypackage, masterytype, shiptype, shipfaction])
}