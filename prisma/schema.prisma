// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Ship {
  id Int @id @default(autoincrement())

  name               String  @unique
  description        String?
  tier               Int?
  type               String?
  hull               String?
  hullMod            Float?
  shieldMod          Float?
  turnRate           Float?
  impulse            Float?
  inertia            Int?
  foreWeapons        Int?
  aftWeapons         Int?
  tacticalSlots      Int?
  engineeringSlots   Int?
  scienceSlots       Int?
  secondaryDeflector Boolean @default(false)

  rawData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StarshipTrait {
  id Int @id @default(autoincrement())

  name  String  @unique
  short String?
  type  String?

  rawData Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Trait {
  Id Int @id @default(autoincrement())

  name             String  @unique
  type             String?
  environment      String?
  description      String?
  shortDescription String?
  required         String?
  possible         String?
  career           String?
  source           String?
  charVariant      String?
  boffVariant      String?
  doffVariant      String?
  iconName         String?
  master           String?

  rawData Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
