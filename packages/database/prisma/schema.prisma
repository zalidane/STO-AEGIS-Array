// Shared schema for Extractor, GraphQL, and other apps via @sto-aegis/database

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Ship {
  id Int @id @default(autoincrement())

  name               String  @unique
  description        String? // not present in current Ships.json extracts
  image              String?
  image2             String?
  released           String?
  internalName       String?
  fc                 Boolean @default(false)
  faction            String?
  facSort            String?
  rank               String?
  rankLevel          Int?
  tier               Int?
  upgradeCost        String?
  type               String?
  hull               String?
  hullMod            Float?
  shieldMod          Float?
  turnRate           Float?
  impulse            Float?
  inertia            Int?
  powerAll           Int?
  powerWeapons       Int?
  powerShields       Int?
  powerEngines       Int?
  powerAuxiliary     Int?
  powerBoost         Int?
  boffs              String?
  foreWeapons        Int?
  aftWeapons         Int?
  equipCannons       Boolean?
  devices            Int?
  tacticalSlots      Int?
  engineeringSlots   Int?
  scienceSlots       Int?
  uniconsole         String?
  t5uConsole         String?
  experimental       Boolean @default(false)
  secondaryDeflector Boolean @default(false)
  hangars            Int?
  cost               String?
  abilities          String?
  admiraltyEng       Int?
  admiraltyTac       Int?
  admiraltySci       Int?
  displayPrefix      String?
  displayClass       String?
  displayType        String?
  factionLede        String?

  rawData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  starshipTraits StarshipTraitShip[]
  shipTypeId     Int?
  shipType       ShipType?           @relation(fields: [shipTypeId], references: [id])
  uniconsoleId   Int?
  uniConsole     Infobox?            @relation("ShipUniConsole", fields: [uniconsoleId], references: [id])
  experimentalWeapon   String?
  experimentalWeaponId Int?
  experimentalWeaponItem Infobox?    @relation("ShipExperimentalWeapon", fields: [experimentalWeaponId], references: [id])
}

model StarshipTrait {
  id Int @id @default(autoincrement())

  name     String  @unique
  short    String?
  basic    String?
  detailed String?
  type     String?
  obtained String?
  iconName String?
  tag      String?
  tag2     String?
  tag3     String?

  rawData Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ships              StarshipTraitShip[]
  masteryAsPrimary   Mastery[]           @relation("MasteryPrimaryTrait")
  masteryAsSecondary Mastery[]           @relation("MasterySecondaryTrait")
  masteryAsTertiary  Mastery[]           @relation("MasteryTertiaryTrait")
  masteryAsAccount   Mastery[]           @relation("MasteryAccountTrait")
}

model Trait {
  Id Int @id @default(autoincrement())

  name        String
  type        String?
  environment String?

  description      String?
  shortDescription String?
  required         String?
  possible         String?
  career           String?
  source           String?
  charVariant      String?
  boffVariant      String?
  doffVariant      String?
  iconName         String?
  master           String?

  rawData Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, type, environment])
}

model GwObtain {
  id        Int      @id @default(autoincrement())
  cat       String
  type      String
  flavor    String
  box       String?
  lb        String?
  lockBoxId Int?
  lockBox   Infobox? @relation("GwLockBox", fields: [lockBoxId], references: [id])
  rep       String?
  rawData   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cat, type, flavor])
}

model SwObtain {
  id        Int      @id @default(autoincrement())
  cat       String
  type      String
  flavor    String
  box       String?
  lb        String?
  lockBoxId Int?
  lockBox   Infobox? @relation("SwLockBox", fields: [lockBoxId], references: [id])
  rep       String?
  ships     String?
  rawData   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cat, type, flavor])
}

model Modifier {
  id        Int      @id @default(autoincrement())
  modifier  String
  stats     String?
  type      String
  available String? // comma-separated list — keep as String
  isunique  Boolean  @default(false)
  isepic    Boolean  @default(false)
  info      String?
  rawData   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ModifierItem[]

  @@unique([modifier, type])
}

model Reputation {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  color1      String?
  color2      String?
  icon        String?
  link        String?
  description String?
  released    String?
  environment String?
  boff        Boolean?
  secondary   Boolean?
  rawData     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SetBonus {
  id         Int      @id @default(autoincrement())
  name       String   @unique // cargo: Name
  setPage    String? // SetPage
  reqItems   Int? // ReqItems as Int
  passives   String? // ;-separated — keep String
  traySkills String?
  procs      String?
  abilities  String?
  rawData    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TraySkill {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  system          String?
  description     String?
  descriptionLong String? // cargo: "description long"
  targets         String?
  affects         String?
  activation      String? // keep String (mix of "0.5" and "1.25 seconds")
  rechargeBase    Int? // "recharge base"
  rechargeGlobal  Int? // "recharge global"
  type            String?
  region          String?
  rank1rank       String?
  rank2rank       String?
  rank3rank       String?
  rank4rank       String?
  rank5rank       String?
  rank1info       String?
  rank2info       String?
  rank3info       String?
  rank4info       String?
  rank5info       String?
  rawData         Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Infobox {
  id         Int      @id @default(autoincrement())
  name       String
  rarity     String?
  type       String?
  boundto    String?
  boundwhen  String?
  who        String?
  head1      String?
  head2      String?
  head3      String?
  head4      String?
  head5      String?
  head6      String?
  head7      String?
  head8      String?
  head9      String?
  subhead1   String?
  subhead2   String?
  subhead3   String?
  subhead4   String?
  subhead5   String?
  subhead6   String?
  subhead7   String?
  subhead8   String?
  subhead9   String?
  text1      String?
  text2      String?
  text3      String?
  text4      String?
  text5      String?
  text6      String?
  text7      String?
  text8      String?
  text9      String?
  equiplimit Int?
  image      String?
  rawData    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  gwLockBoxes      GwObtain[]     @relation("GwLockBox")
  swLockBoxes      SwObtain[]     @relation("SwLockBox")
  modifierItems    ModifierItem[]
  shipsWithConsole Ship[]         @relation("ShipUniConsole")
  shipsWithExperimentalWeapon Ship[] @relation("ShipExperimentalWeapon")

  @@index([name])
}

model Mastery {
  id             Int     @id @default(autoincrement())
  masterytype    String
  shiptype       String
  shipfaction    String
  masterypackage String
  trait          String?
  traitdesc      String?
  trait2         String?
  traitdesc2     String?
  trait3         String?
  traitdesc3     String?
  acctrait       String?
  acctraitdesc   String?

  traitId    Int?
  trait2Id   Int?
  trait3Id   Int?
  acctraitId Int?

  primaryTrait   StarshipTrait? @relation("MasteryPrimaryTrait", fields: [traitId], references: [id])
  secondaryTrait StarshipTrait? @relation("MasterySecondaryTrait", fields: [trait2Id], references: [id])
  tertiaryTrait  StarshipTrait? @relation("MasteryTertiaryTrait", fields: [trait3Id], references: [id])
  accountTrait   StarshipTrait? @relation("MasteryAccountTrait", fields: [acctraitId], references: [id])

  shipTypeId Int?
  shipType   ShipType? @relation(fields: [shipTypeId], references: [id])

  rawData   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([masterypackage, masterytype, shiptype, shipfaction])
}

/**
 * Relationship Schemas
 */
model StarshipTraitShip {
  starshipTraitId Int
  shipId          Int

  ship          Ship          @relation(fields: [shipId], references: [id], onDelete: Cascade)
  starshipTrait StarshipTrait @relation(fields: [starshipTraitId], references: [id], onDelete: Cascade)

  @@id([starshipTraitId, shipId])
  @@index([shipId])
}

model ShipType {
  id   Int    @id @default(autoincrement())
  name String @unique

  ships     Ship[]
  masteries Mastery[]
}

model ModifierItem {
  modifierId Int
  infoboxId  Int

  modifier Modifier @relation(fields: [modifierId], references: [id], onDelete: Cascade)
  infobox  Infobox  @relation(fields: [infoboxId], references: [id], onDelete: Cascade)

  @@id([modifierId, infoboxId])
  @@unique([modifierId, infoboxId])
}
