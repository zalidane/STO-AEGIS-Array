{
  "name": "@sto-aegis/extractor",
  "version": "1.0.0",
  "private": true,
  "description": "STOWiki Cargo extractor and PostgreSQL importer",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/main.ts extract",
    "extract": "tsx src/main.ts extract",
    "extract:force": "tsx src/main.ts extract --force-refresh",
    "extract:images": "tsx src/main.ts extract --images-only",
    "align-images": "tsx src/alignLocalImages.ts",
    "import": "tsx src/main.ts import",
    "import:force": "tsx src/main.ts import --force-import",
    "import:prod": "tsx src/main.ts import --prod --force-import",
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@sto-aegis/database": "*",
    "dotenv": "^17.4.2",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
