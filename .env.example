# Local database (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sto_aegis"

# STOWiki extract — bot passwords are optional (STOWiki currently restricts Special:BotPasswords).
# Shown in the User-Agent so wiki admins can identify this client
STOWIKI_CONTACT=""
# If staff enable a bot password for you:
# STOWIKI_BOT_USERNAME="YourAccount@BotName"
# STOWIKI_BOT_PASSWORD=""

# Vue image host. Inlined at VueUI build time. Leave unset to serve /images
# from Vite. Set on the Railway VueUI service only after R2 is verified.
# VITE_IMAGE_BASE_URL=https://img.aegisarray.com

# Cloudflare R2 sync (`npm run images:sync`). Never commit real keys.
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_BUCKET=aegis-images
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_REGION=auto

# Optional
# STOWIKI_API_URL="https://stowiki.net/w/api.php"
# STOWIKI_MIN_DELAY_MS=2500
# STOWIKI_MAX_RETRIES=8
# STOWIKI_USER_AGENT="STO-AEGIS-Array/1.0 (https://github.com/zalidane/STO-AEGIS-Array; you@example.com)"
